# Copy to .env and fill in. Never commit .env.

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Hindsight Cloud (https://ui.hindsight.vectorize.io). Promo code MEMHACK99 goes in Billing after sign-up.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
# Self-hosted open-source Hindsight instead: HINDSIGHT_BASE_URL=http://localhost:8888 and leave the key empty.
HINDSIGHT_BANK_PREFIX=schedly

# Feedback: read submissions at /api/feedback?key=<this key>. Optional webhook (e.g. Slack incoming webhook).
FEEDBACK_ADMIN_KEY=change-me
FEEDBACK_WEBHOOK_URL=

PORT=3000
